@model SkyScan.Presentation.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<main class="relative min-h-screen flex items-center justify-center md:justify-start px-6 md:px-24 overflow-hidden pt-20">
    <!-- Full-screen background image of airplane -->
    <div class="absolute inset-0 z-0">
        <img class="w-full h-full object-cover" alt="airplane flying" src="/images/plane_bg.png" />
        <div class="absolute inset-0 bg-slate-950/20"></div>
    </div>

    <!-- Floating login card -->
    <section class="relative z-10 w-full max-w-md bg-white text-slate-900 rounded-3xl p-10 shadow-2xl border border-slate-100 flex flex-col gap-6 animate-in fade-in slide-in-from-bottom-8 duration-700">
        <div class="text-left space-y-1">
            <h1 class="font-headline text-3xl font-extrabold tracking-tight text-[#141A32]">Sign In</h1>
            <p class="text-slate-500 text-sm font-light">Access your premium SkyScan Concierge profile.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="text-red-600 text-xs font-semibold bg-red-50 p-3 rounded-lg border border-red-200">
                @TempData["Error"]
            </div>
        }

        <!-- Google Sign In Button -->
        <form asp-controller="Account" asp-action="GoogleLogin" method="post" class="w-full">
            <button type="submit"
                    class="w-full flex items-center justify-center gap-3 bg-white hover:bg-slate-50 text-slate-800 font-bold py-3 px-6 rounded-xl border border-slate-200 transition-all text-sm shadow-sm cursor-pointer">
                <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Continue with Google
            </button>
        </form>

        <div class="flex items-center gap-4">
            <div class="flex-1 h-px bg-slate-200"></div>
            <span class="text-[10px] uppercase tracking-widest text-slate-400">or</span>
            <div class="flex-1 h-px bg-slate-200"></div>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs font-semibold bg-red-50 p-3 rounded-lg border border-red-200"></div>

            <div class="space-y-4">
                <div class="group relative">
                    <label asp-for="Email" class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
                    <input asp-for="Email" class="w-full bg-slate-50 border border-slate-200 p-3.5 rounded-xl text-slate-800 font-body text-sm focus:border-[#141A32] focus:ring-1 focus:ring-[#141A32] outline-none transition-all placeholder:text-slate-400" placeholder="john@example.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-[10px] mt-1 block"></span>
                </div>

                <div class="group relative">
                    <div class="flex justify-between items-center mb-1">
                        <label asp-for="Password" class="block text-xs font-semibold text-slate-700">Password</label>
                        <a asp-action="ForgotPassword" class="text-xs text-blue-600 hover:text-blue-800 transition-colors">Forgot Password?</a>
                    </div>
                    <input asp-for="Password" type="password" class="w-full bg-slate-50 border border-slate-200 p-3.5 rounded-xl text-slate-800 font-body text-sm focus:border-[#141A32] focus:ring-1 focus:ring-[#141A32] outline-none transition-all placeholder:text-slate-400" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-500 text-[10px] mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <input asp-for="RememberMe" class="w-4 h-4 rounded border-slate-300 bg-slate-50 text-[#141A32] focus:ring-[#141A32]" />
                        <label asp-for="RememberMe" class="text-xs text-slate-600 font-medium"></label>
                    </div>
                </div>

                <button type="submit" class="w-full bg-[#141A32] hover:bg-slate-800 text-white font-headline font-bold uppercase tracking-widest text-sm py-4 rounded-xl transition-all cursor-pointer shadow-md shadow-slate-900/10">
                    Sign In
                </button>
            </div>
        </form>

        <div class="border-t border-slate-100 pt-4 text-center space-y-2">
            <p class="text-xs text-slate-600">Don't have an account yet?
                <a asp-action="Register" class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Apply for Access</a>
            </p>
            <p class="text-xs text-slate-500">Didn't receive confirmation email?
                <a asp-action="ResendEmailConfirmation" class="text-slate-600 hover:text-slate-800 transition-colors underline">Resend it</a>
            </p>
        </div>
    </section>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
