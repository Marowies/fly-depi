@model SkyScan.Presentation.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<main class="min-h-screen flex flex-col md:flex-row bg-white relative pt-20">
    <!-- Left panel (White background with illustration) -->
    <div class="flex-1 bg-white flex flex-col items-center justify-center p-8 md:p-16 z-10">
        <div class="max-w-md w-full text-center md:text-left space-y-4">
            <img class="w-72 h-72 mx-auto md:mx-0 object-contain" alt="working illustration" src="https://illustrations.popsy.co/blue/work-from-home.svg" />
        </div>
    </div>

    <!-- Right panel (Blue background with rounded white login card) -->
    <div class="flex-1 bg-[#0066FF] flex items-center justify-center p-6 md:p-12 z-10 relative">
        <!-- Floating login card -->
        <section class="w-full max-w-md bg-white text-slate-900 rounded-3xl p-10 shadow-2xl flex flex-col gap-6 animate-in fade-in slide-in-from-bottom-8 duration-700">
            <div class="text-left space-y-1">
                <h1 class="font-headline text-3xl font-extrabold tracking-tight text-[#141A32]">Hello!</h1>
                <p class="text-slate-500 text-sm font-light">Sign In to Get Started</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="text-red-600 text-xs font-semibold bg-red-50 p-3 rounded-lg border border-red-200">
                    @TempData["Error"]
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs font-semibold bg-red-50 p-3 rounded-lg border border-red-200"></div>

                <div class="space-y-4">
                    <div class="group relative">
                        <label asp-for="Email" class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
                        <input asp-for="Email" class="w-full bg-white border border-slate-200 p-3.5 rounded-full text-slate-800 font-body text-sm focus:border-[#0066FF] focus:ring-1 focus:ring-[#0066FF] outline-none transition-all placeholder:text-slate-400" placeholder="Email Address" />
                        <span asp-validation-for="Email" class="text-red-500 text-[10px] mt-1 block"></span>
                    </div>

                    <div class="group relative">
                        <label asp-for="Password" class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
                        <input asp-for="Password" type="password" class="w-full bg-white border border-slate-200 p-3.5 rounded-full text-slate-800 font-body text-sm focus:border-[#0066FF] focus:ring-1 focus:ring-[#0066FF] outline-none transition-all placeholder:text-slate-400" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-red-500 text-[10px] mt-1 block"></span>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <input asp-for="RememberMe" class="w-4 h-4 rounded border-slate-300 bg-white text-[#0066FF] focus:ring-[#0066FF]" />
                            <label asp-for="RememberMe" class="text-xs text-slate-600 font-medium"></label>
                        </div>
                        <a asp-action="ForgotPassword" class="text-xs text-[#0066FF] hover:underline transition-all">Forgot Password?</a>
                    </div>

                    <button type="submit" class="w-full bg-[#0066FF] hover:bg-[#0055DD] text-white font-headline font-bold uppercase tracking-widest text-sm py-4 rounded-full transition-all cursor-pointer shadow-md">
                        Login
                    </button>
                </div>
            </form>

            <div class="flex items-center gap-4">
                <div class="flex-1 h-px bg-slate-200"></div>
                <span class="text-[10px] uppercase tracking-widest text-slate-400">or</span>
                <div class="flex-1 h-px bg-slate-200"></div>
            </div>

            <!-- Google Sign In Button -->
            <form asp-controller="Account" asp-action="GoogleLogin" method="post" class="w-full">
                <button type="submit"
                        class="w-full flex items-center justify-center gap-3 bg-white hover:bg-slate-50 text-slate-800 font-bold py-3.5 px-6 rounded-full border border-slate-200 transition-all text-sm shadow-sm cursor-pointer">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Continue with Google
                </button>
            </form>

            <div class="border-t border-slate-100 pt-4 text-center space-y-2">
                <p class="text-xs text-slate-600">Don't have an account yet?
                    <a asp-action="Register" class="text-[#0066FF] font-semibold hover:underline transition-colors">Apply for Access</a>
                </p>
                <p class="text-xs text-slate-500">Didn't receive confirmation email?
                    <a asp-action="ResendEmailConfirmation" class="text-slate-600 hover:text-slate-800 transition-colors underline">Resend it</a>
                </p>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
